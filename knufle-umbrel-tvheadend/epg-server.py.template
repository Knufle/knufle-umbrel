def fetch_json(path):
    with urllib.request.urlopen(f"{TVHEADEND_URL}{path}", timeout=30) as response:
        return json.load(response)


def png_chunk(kind, payload):
    checksum = zlib.crc32(kind + payload) & 0xFFFFFFFF
    return struct.pack(">I", len(payload)) + kind + payload + struct.pack(">I", checksum)


def label_logo(label):
    text = str(label or "?").upper()
    scale = 4
    spacing = 2
    text_width = sum(6 if character != " " else 3 for character in text) - spacing
    width = max(160, text_width * scale + 24)
    height = 52
    pixels = bytearray(width * height * 4)
    offset_x = (width - text_width * scale) // 2
    offset_y = (height - 7 * scale) // 2

    cursor = offset_x
    for character in text:
        if character == " ":
            cursor += 3 * scale
            continue
        glyph = _FONT.get(character, _FONT["?"])
        for row, bits in enumerate(glyph):
            for column, bit in enumerate(bits):
                if bit != "1":
                    continue
                for pixel_y in range(scale):
                    for pixel_x in range(scale):
                        index = (
                            (offset_y + row * scale + pixel_y) * width
                            + cursor
                            + column * scale
                            + pixel_x
                        ) * 4
                        pixels[index : index + 4] = b"\xff\xff\xff\xff"
        cursor += 6 * scale

    scanlines = bytearray()
    stride = width * 4
    for row in range(height):
        scanlines.append(0)
        scanlines.extend(pixels[row * stride : (row + 1) * stride])

    header = struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0)
    return (
        b"\x89PNG\r\n\x1a\n"
        + png_chunk(b"IHDR", header)
        + png_chunk(b"IDAT", zlib.compress(bytes(scanlines), 9))
        + png_chunk(b"IEND", b"")
    )


def available_icon(channel):
    path = channel.get("icon_public_url")
    if not path:
        return None
    url = f"{TVHEADEND_PUBLIC_URL}/{path.lstrip('/')}"
    try:
        request = urllib.request.Request(url, method="HEAD")
        with urllib.request.urlopen(request, timeout=5) as response:
            if 200 <= response.status < 300:
                return url
    except (OSError, urllib.error.URLError):
        pass
    return None


def fallback_title(event):
    for key in ("title", "subtitle", "description"):
        value = str(event.get(key) or "").strip()
        if value:
            return value
    return event["channelName"]


def clean_text(value):
    return str(value or "").translate(_DVB_LATIN1_REPAIRS).strip()


def xmltv_time(timestamp):
    return datetime.fromtimestamp(int(timestamp), timezone.utc).strftime(
        "%Y%m%d%H%M%S +0000"
    )


def build_xmltv():
    channel_data = fetch_json("/api/channel/grid?limit=1000&start=0&all=1")
    event_data = fetch_json("/api/epg/events/grid?limit=99999&start=0")

    channels = [
        channel
        for channel in channel_data.get("entries", [])
        if channel.get("enabled") and channel.get("name") and channel.get("uuid")
    ]
    channel_ids = {channel["uuid"] for channel in channels}

    root = ET.Element("tv")
    root.set("generator-info-name", "Tvheadend EPG Bridge")
    root.set("source-info-name", "Tvheadend /api/epg/events/grid")

    logos = {}
    for channel in sorted(channels, key=lambda item: item["name"].casefold()):
        node = ET.SubElement(root, "channel", id=channel["uuid"])
        ET.SubElement(node, "display-name", lang="pt").text = channel["name"]
        icon_url = available_icon(channel)
        if icon_url is None:
            icon_url = f"{EPG_PUBLIC_URL}/logo/{channel['uuid']}.png"
            logos[channel["uuid"]] = label_logo(channel["name"])
        ET.SubElement(node, "icon", src=icon_url)
        number = channel.get("number")
        if number not in (None, "", 0, "0"):
            ET.SubElement(node, "display-name").text = str(number)

    channels_with_programmes = set()
    for event in event_data.get("entries", []):
        channel_id = event.get("channelUuid")
        if channel_id not in channel_ids:
            continue
        start = event.get("start")
        stop = event.get("stop")
        if not start or not stop or stop <= start:
            continue

        channels_with_programmes.add(channel_id)
        programme = ET.SubElement(
            root,
            "programme",
            channel=channel_id,
            start=xmltv_time(start),
            stop=xmltv_time(stop),
        )
        ET.SubElement(programme, "title", lang="pt").text = clean_text(
            fallback_title(event)
        )
        if event.get("subtitle"):
            ET.SubElement(programme, "sub-title", lang="pt").text = clean_text(
                event["subtitle"]
            )
        if event.get("description"):
            ET.SubElement(programme, "desc", lang="pt").text = clean_text(
                event["description"]
            )
        for category in event.get("genre") or []:
            ET.SubElement(programme, "category", lang="pt").text = str(category)
        if event.get("ageRating") is not None:
            ET.SubElement(programme, "rating", system="TV").text = str(
                event["ageRating"]
            )

    fallback_start = (int(time.time()) // 7200) * 7200
    fallback_stop = fallback_start + (72 * 60 * 60)
    for channel in channels:
        if channel["uuid"] in channels_with_programmes:
            continue
        for start in range(fallback_start, fallback_stop, 7200):
            programme = ET.SubElement(
                root,
                "programme",
                channel=channel["uuid"],
                start=xmltv_time(start),
                stop=xmltv_time(start + 7200),
            )
            ET.SubElement(programme, "title", lang="pt").text = clean_text(
                channel["name"]
            )
            ET.SubElement(programme, "desc", lang="pt").text = (
                "Programação em direto. O guia OTA não forneceu dados detalhados."
            )

    return ET.tostring(root, encoding="utf-8", xml_declaration=True), logos


def refresh_loop():
    global _xml_bytes, _logos, _xml_error
    while True:
        try:
            current, logos = build_xmltv()
            with _lock:
                _xml_bytes = current
                _logos = logos
                _xml_error = ""
            print(
                f"refreshed XMLTV: {len(current)} bytes",
                flush=True,
            )
        except Exception as error:
            with _lock:
                _xml_error = str(error)
            print(f"XMLTV refresh failed: {error}", flush=True)
        time.sleep(REFRESH_SECONDS)


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path.startswith("/logo/") and path.endswith(".png"):
            channel_id = path[len("/logo/") : -len(".png")]
            with _lock:
                body = _logos.get(channel_id)
            if body:
                self.send_response(200)
                self.send_header("Content-Type", "image/png")
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "public, max-age=300")
                self.end_headers()
                self.wfile.write(body)
            else:
                self.send_error(404)
            return
        if path not in ("/", "/xmltv.xml"):
            self.send_error(404)
            return
        with _lock:
            body = _xml_bytes
            error = _xml_error
        if not body:
            self.send_error(503, error)
            return
        self.send_response(200)
        self.send_header("Content-Type", "application/xml; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, message, *args):
        print(f"{self.address_string()} - {message % args}", flush=True)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--once":
        sys.stdout.buffer.write(build_xmltv()[0])
    else:
        threading.Thread(target=refresh_loop, daemon=True).start()
        ThreadingHTTPServer(("0.0.0.0", BIND_PORT), Handler).serve_forever()
